# Copy this file to .env.local for running on your own computer.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# From console.anthropic.com → API Keys. Never commit the real value.
ANTHROPIC_API_KEY=sk-ant-...

# From Neon (Vercel adds this one for you when you connect a Neon database).
DATABASE_URL=postgres://...

# The passphrase you type to get into the app.
APP_PASSWORD=choose-something-long

# The app stops calling Claude once this month's spending reaches this many dollars.
MONTHLY_BUDGET_USD=30
